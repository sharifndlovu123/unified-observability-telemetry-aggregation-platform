# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=dev
APP_VERSION=0.1.0

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
DEBUG=false
FAULTS_ENABLED=true

# Postgres / Redis
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379/0


# Collector destinations: on/off flags (default true = everything available is on).
# After changing, run `make collector-reload`. The app is never touched.
EXPORT_DEBUG=true
EXPORT_PROMETHEUS=true

# Elastic stack
ELASTIC_PASSWORD=change-me
KIBANA_SYSTEM_PASSWORD=change-me

# Grafana
GF_SECURITY_ADMIN_PASSWORD=change-me

# Datadog (optional; leave disabled to run fully locally)
DD_ENABLED=false
DD_API_KEY=
DD_SITE=datadoghq.com

# OpenTelemetry (app side)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
DEBUG_EXPORTER_VERBOSITY=basic
